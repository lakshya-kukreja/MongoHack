# MongoDB Atlas Persistent Storage Configuration
# Set MONGODB_URI to your MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority)
# Leave empty to run with the fast in-memory storage fallback for offline development and testing.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=incident_investigator
# Atlas Vector Search index name. Must match the deployed index exactly; Atlas
# returns zero results (not an error) when this name does not exist.
VECTOR_INDEX_NAME=vector_index

# Embedding Provider Configuration (gemini | openai)
# Gemini is the default. gemini-embedding-2 supports Matryoshka truncation and
# is asked for exactly 1536 dimensions to match backend/atlas_vector_index.json.
# Free-tier text input is supported; check current Gemini API pricing/rate limits.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=<your-gemini-api-key>
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# LLM Provider Configuration (gemini | openai)
# Selection is explicit; there is no automatic runtime provider fallback.
# - Gemini: LLM_PROVIDER=gemini, LLM_MODEL_NAME=gemini-3.8-flash (free-tier compatible)
# - OpenAI: LLM_PROVIDER=openai, LLM_MODEL_NAME=gpt-4o-mini, LLM_API_KEY=<OpenAI API key>
# LLM_API_KEY must match LLM_PROVIDER. OpenAI API keys/billing are separate from
# ChatGPT subscriptions. LLM_MODEL_NAME must also match the selected provider.
# Embeddings are configured independently below and can stay on Gemini.
LLM_PROVIDER=gemini
LLM_API_KEY=<your-llm-provider-api-key>
LLM_MODEL_NAME=gemini-3.8-flash
# Gemini only: minimal | low | medium | high. none/off/default omits thinking.
LLM_GEMINI_THINKING_LEVEL=low
# Bounded retries stay inside a hard 30s wall-clock budget.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=4.0
LLM_REQUEST_DEADLINE_SECONDS=30.0

# Server & CORS Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
